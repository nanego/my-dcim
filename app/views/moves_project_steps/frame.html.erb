<% breadcrumb.add_step("#{Frame.model_name.human} #{@frame}") %>

<%= render Page::HeadingComponent.new(
      breadcrumb:,
      back_button_url: moves_project_step_moves_path(@moves_project_step),
    )  do |heading| %>

  <% heading.with_title do %>
    <div class="d-flex align-items-center gap-2">
      <h1><%= t(".title", frame: @frame) %></h1>

      <span class="dropdown move-step_frame_dropdown">
        <button class="btn btn-sm text-start dropdown-toggle d-inline-flex align-items-center fs-2"
                title="<%= @moves_project_step %>"
                data-bs-toggle="dropdown"
                aria-expanded="false">
          <span class="d-inline-block text-truncate"><%= @moves_project_step %></span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end">
          <% @moves_project.steps.each do |step| %>
            <li>
              <a class="dropdown-item"
                href="<%= frame_moves_project_moves_project_step_path(@moves_project, step, @frame) %>">
                <%= step %>
              </a>
            </li>
          <% end %>
        </ul>
      </span>
    </div>
  <% end %>

  <% heading.with_right_content do %>
    <span>
      <button type="button" class="btn btn-lg link-secondary" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="bi bi-three-dots-vertical"></span>
      </button>
      <ul class="dropdown-menu">
        <li>
          <%= link_to print_moves_project_moves_project_step_path(
                @moves_project_step.moves_project, @moves_project_step, @frame,
              ),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top },
                      target: :_blank,
                      rel: :noopener do %>
            <span class="bi bi-printer me-1"></span>
            <span><%= t("export_button.exports.print") %></span>
          <% end %>
        </li>
        <li>
          <%= link_to print_moves_project_moves_project_step_path(
                @moves_project_step.moves_project, @moves_project_step, @frame, format: :pdf,
              ),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-file-earmark-pdf me-1"></span>
            <span><%= t("export_button.exports.pdf") %></span>
          <% end %>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to visualization_frame_path(@frame),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-diagram-3-fill text-primary  me-1"></span>
            <span><%= t("visualization.title") %></span>
          <% end %>
        </li>
        <li>
          <%= link_to frame_path(@frame),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-eye text-primary me-1"></span>
            <span><%= t("action.show") %></span>
          <% end %>
        </li>
      </ul>
    </span>
  <% end %>
<% end %>

<div class="p-4 border-top d-flex flex-column">
  <div class="row row-cols-1 row-cols-xl-2 row-gap-4">
    <div class="col col-xl-7 pe-none">
      <%= render partial: "visualization/frames/show_frame",
                 locals: {
                   frame: @frame,
                   servers: @servers,
                   view_type: "back",
                   settings: { min_height: 20 },
                 } %>
    </div>

    <div class="col col-xl-5 d-flex flex-column row-gap-4">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= Move.model_name.human(count: 2) %>
        <% end %>

        <% if @moves.any? %>
          <% card.with_body(extra_classes: "p-0") do %>
            <ul class="list-group list-group-flush">
              <% @moves.sort_by(&:step).each do |move| %>
                <li class="list-group-item">
                  <div class="d-flex align-items-start">
                    <span class="bi bi-box-seam position-relative me-1 <%= move.decorated.text_color_related_to_frame(@frame) %>"
                          data-controller="tooltip"
                          data-bs-placement="top"
                          title="<%= move.decorated.planned_or_executed_date %>">
                      <% if move.executed? %>
                        <span class="position-absolute top-50 mt-2 start-100 translate-middle badge rounded-pill p-0 \
                                    bg-success small">
                          <span class="bi bi-check"></span>
                          <span class="visually-hidden"><%= Move.human_attribute_name("status.#{move.status}") %></span>
                        </span>
                      <% end %>
                    </span>
                    <%= link_to move.decorated.display_name,
                                moves_project_step_move_path(move.step, move),
                                class: "mx-2 link-body-emphasis link-offset-2 link-underline-opacity-0 \
                                        link-underline-opacity-75-hover" %>
                  </div>

                  <span class="d-flex column-gap-2 align-items-center text-secondary mt-1">
                    <span class="small">
                      <% if move.prev_frame != move.frame && move.frame == @frame %>
                        <%= link_to(
                              move.prev_frame,
                              frame_moves_project_moves_project_step_path(
                                @moves_project, @moves_project_step, move.prev_frame,
                              ),
                              class: "link-secondary link-offset-2 link-underline-opacity-0 \
                                  link-underline-opacity-75-hover",
                            ) %>
                        <span> - </span>
                      <% end %>

                      <span><%= [Frame.human_attribute_name(:u), move.prev_position].join %></span>
                    </span>
                    <span class="bi bi-arrow-right <%= move.decorated.text_color_related_to_frame(@frame) %>">
                    </span>
                    <span class="small">
                      <% if move.prev_frame != move.frame && move.prev_frame == @frame %>
                        <%= link_to(
                              move.frame,
                              frame_moves_project_moves_project_step_path(
                                @moves_project, @moves_project_step, move.frame,
                              ),
                              class: "link-secondary link-offset-2 link-underline-opacity-0 \
                                  link-underline-opacity-75-hover",
                            ) %>
                        <span> - </span>
                      <% end %>

                      <span><%= [Frame.human_attribute_name(:u), move.position].join %></span>
                    </span>
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% else %>
          <%= render EmptyDataComponent.new %>
        <% end %>
      <% end %>

      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= Move::Connection.model_name.human.pluralize %>
        <% end %>

        <% if @move_connections.any? %>
          <% card.with_body(extra_classes: "p-0") do %>
            <ul class="list-group list-group-flush">
              <% @move_connections.each do |move_connection| %>
                <li class="list-group-item">
                  <%= render partial: "moves/connections/draw", locals: { move_connection: } %>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% else %>
          <%= render EmptyDataComponent.new %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
