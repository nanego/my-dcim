<% breadcrumb.add_step("#{Frame.model_name.human} #{@frame}") %>

<%= render Page::HeadingComponent.new(
      title: t(".title", frame: @frame, step: @moves_project_step),
      breadcrumb:,
      back_button_url: moves_project_step_moves_path(@moves_project_step),
    )  do |heading| %>

  <% heading.with_right_content do %>
    <span>
      <button type="button" class="btn btn-lg link-secondary" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="bi bi-three-dots-vertical"></span>
      </button>
      <ul class="dropdown-menu">
        <li>
          <%= link_to print_moves_project_moves_project_step_path(
                @moves_project_step.moves_project, @moves_project_step, @frame,
              ),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top },
                      target: :_blank,
                      rel: :noopener do %>
            <span class="bi bi-printer me-1"></span>
            <span><%= t("export_button.exports.print") %></span>
          <% end %>
        </li>
        <li>
          <%= link_to print_moves_project_moves_project_step_path(
                @moves_project_step.moves_project, @moves_project_step, @frame,
              ),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-file-earmark-pdf me-1"></span>
            <span><%= t("export_button.exports.pdf") %></span>
          <% end %>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to visualization_frame_path(@frame),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-diagram-3-fill me-1"></span>
            <span><%= t("visualization.title") %></span>
          <% end %>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
          <%= link_to frame_path(@frame),
                      class: "dropdown-item",
                      data: { turbo_frame: :_top } do %>
            <span class="bi bi-eye me-1"></span>
            <span><%= t("action.show") %></span>
          <% end %>
        </li>
      </ul>
    </span>
  <% end %>
<% end %>

<div class="p-4 border-top d-flex flex-column row-gap-4">
  <%= render partial: "visualization/frames/show_frame",
             locals: {
               frame: @frame,
               servers: @servers,
               view_type: "back",
               settings: { min_height: 20 },
             } %>

  <div class="row">
    <div class="col-12 col-lg-6">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= Move.model_name.human(count: 2) %>
        <% end %>

        <% card.with_body(extra_classes: "p-0") do %>
          <ul class="list-group list-group-flush">
            <% @moves.sort_by(&:step).each do |move| %>
              <li class="list-group-item">
                <div class="d-flex align-items-start">
                  <span class="bi bi-box-seam text-primary"></span>
                  <%= link_to move.decorated.display_name,
                              moves_project_step_move_path(move.step, move),
                              class: "mx-2 link-body-emphasis link-offset-2 link-underline-opacity-0 \
                                      link-underline-opacity-75-hover",
                              title: move.step,
                              aria: { label: move.step },
                              data: { turbo_frame: :_top, controller: "tooltip" } %>

                  <span data-controller="tooltip"
                        data-bs-placement="top"
                        title="<%= move.decorated.planned_or_executed_date %>">
                    <%= render move.decorated.status_to_badge_component(with_text: false) %>
                  </span>
                </div>

                <span class="d-flex column-gap-2 align-items-center text-secondary mt-1">
                  <span class="small">
                    <% frame = move.prev_frame == @frame ? nil : move.prev_frame %>

                    <%= [frame, "#{Frame.human_attribute_name(:u)}#{move.prev_position}"].compact.join(" - ") %>
                  </span>
                  <span class="<%= class_names("bi bi-arrow-right",
                                               "text-danger": move.prev_frame == @frame,
                                               "text-success": move.frame == @frame) %>">
                  </span>
                  <span class="small">
                    <% frame = move.frame == @frame ? nil : move.frame %>

                    <%= [frame, "#{Frame.human_attribute_name(:u)}#{move.position}"].compact.join(" - ") %>
                  </span>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>

    <div class="col-12 col-lg-6">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= Move::Connection.model_name.human.pluralize %>
        <% end %>

        <% if @move_connections.any? %>
          <% card.with_body(extra_classes: "p-0") do %>
            <ul class="list-group list-group-flush">
              <% @move_connections.each do |connection| %>
                <li class="list-group-item">
                  <span>
                    <%= connection.decorated.description %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% else %>
          <%= render EmptyDataComponent.new %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
