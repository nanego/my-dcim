<% breadcrumb.add_step(t("action.edit")) %>

<%= render Page::HeadingEditComponent.new(resource: @power_distribution_unit, title: t(".title"), breadcrumb:) %>

<div class="col-12 p-4 border-top d-flex flex-column row-gap-4">
  <div class="alert alert-warning mb-0">
    Cette section est actuellement en cours de développement. Les données peuvent être amenées à être supprimées ou altérées par des changements le temps du développement.
  </div>

  <%= form_with(model: @power_distribution_unit, url: power_distribution_unit_blocks_path(@power_distribution_unit), html: { role: "form" }) do |f| %>
    <%= render FormErrorsComponent.new(@power_distribution_unit) %>

    <div class="row row-cols-1 row-cols-lg-2 row-gap-4">
      <div class="col d-flex flex-column row-gap-4">
        <fieldset data-controller="nested-form">
          <%= render CardComponent.new(extra_classes: "bg-body-tertiary") do |card| %>
            <% card.with_header do %>
              <div class="d-flex justify-content-between align-items-center">
                <%= PowerDistributionUnit::Block.model_name.human.pluralize %>
              </div>
            <% end %>

            <template data-nested-form-target="template">
              <%= f.fields_for :blocks, f.object.blocks.klass.new,
                                child_index: "__NEW_RECORD__" do |block_fields| %>
                <%= render partial: "power_distribution_units/block_fields", locals: { f: block_fields, record: f.object } %>
              <% end %>
            </template>

            <div class="row g-3" data-controller="sortable" data-sortable-target="container">
              <%= f.fields_for :blocks do |block_fields| %>
                <%= render partial: "power_distribution_units/block_fields", locals: { f: block_fields, record: f.object } %>
              <% end %>

              <div data-nested-form-target="target"></div>
            </div>

            <% card.with_footer do %>
              <span class="mx-auto">
                <button type="button" class="btn btn-outline-success btn-sm" data-action="nested-form#add">
                  <span class="bi bi-plus-lg" aria-hidden="true"></span> <%= t(".add_block") %>
                </button>
              </span>
            <% end %>
          <% end %>
        </fieldset>
      </div>

      <div class="col d-flex flex-column row-gap-4">
        <%= render partial: "power_distribution_units/card_nested_fieldset", locals: { f: } %>
      </div>
    </div>

    <%= render Form::ActionsComponent.new(f) %>
  <% end %>
</div>
