<%# locals: (power_distribution_unit:, selected_port: nil) -%>

<div class="d-flex pdu-preview mx-auto">
  <span class="d-flex align-items-center mx-auto flex-column gap-2">
    <table class="slots mx-auto <%= power_distribution_unit.try(:color) %>">
      <tbody>
        <% power_distribution_unit.blocks.each do |block| %>
          <tr><td><%= sockets_by_block(block:, selected_port:) %></td></tr>
        <% end %>

        <% if cards = power_distribution_unit.cards.presence %>
          <tr><td>
            <% cards.each do |card| %>
              <% if card.card_type && card.card_type.columns && card.card_type.rows %>
                <%= ports_by_card_with_presentation(card: card, twin_card_used_ports: nil, selected_port:) %>
              <% else %>
                <%= ports_by_card(port_type: card.card_type.try(:port_type),
                                  port_quantity: card.card_type.try(:port_quantity),
                                  selected_port:,
                                  card: card,
                                  ports_data: card.ports,
                                  twin_card_used_ports: nil) %>
              <% end %>
            <% end %>
          </td></tr>
        <% end %>
      </tbody>
    </table>
  </span>
</div>
