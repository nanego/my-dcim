<%
  breadcrumb
    .add_step(MovesProject.model_name.human(count: 2), moves_projects_path)
    .add_step(title = @moves_project)
%>

<%= render Page::HeadingComponent.new(
      breadcrumb:, title:, back_button_url: moves_projects_path,
    ) do |heading| %>
  <% if created_by = @moves_project.created_by %>
    <p class="mt-2">
      <span class="bi bi-person"></span>
      <span class="ms-1 fw-light text-body-secondary"><%= MovesProject.human_attribute_name(:created_by) %></span>
      <span class="font-monospace"><%= created_by %></span>
    </p>
  <% end %>

  <% heading.with_right_content do %>
    <% if @moves_project.unarchived? %>
      <span>
        <button type="button" class="btn btn-lg link-secondary" data-bs-toggle="dropdown" aria-expanded="false">
          <span class="bi bi-three-dots-vertical"></span>
        </button>
        <ul class="dropdown-menu">
          <li>
            <%= link_to archive_moves_project_path(@moves_project),
                        class: "dropdown-item",
                        method: :patch,
                        data: {
                          confirm: t(".archive_confirmation"),
                        } do %>
              <span class="bi bi-archive text-primary me-1"></span>
              <span><%= t("action.archive") %></span>
            <% end %>
          </li>
          <li>
            <%= link_to edit_moves_project_path(@moves_project),
                        class: "dropdown-item" do %>
              <span class="bi bi-pencil text-info me-1"></span>
              <span><%= t("action.edit") %></span>
            <% end %>
          </li>
        </ul>
      </span>
    <% end %>
  <% end %>
<% end %>

<div class="p-4 border-top d-flex flex-column row-gap-4">
  <div class="row row-gap-4">
    <% @moves_project.steps.each do |moves_project_step| %>
      <div class="col-12">
        <%= render CardComponent.new(extra_classes: "bg-body-tertiary") do |card| %>
          <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="d-inline-flex align-items-center w-75">
              <h4 class="mb-0">
                <span class="bi bi-bar-chart-fill text-body-tertiary me-1"></span>
                <%= link_to moves_project_step,
                            moves_project_step_moves_path(moves_project_step),
                            class: "link-body-emphasis link-offset-2 link-underline-opacity-25 link-underline-opacity-75-hover" %>
              </h4>
              <% if date = moves_project_step.date %>
                <span class="ms-3">
                  <%= render BadgeComponent.new(color: :primary, variant: :pill) do %>
                    <span class="bi bi-calendar-event"></span>
                    <span class="fw-light text-body-secondary ms-1"><%= l(date) %></span>
                  <% end %>
                </span>
              <% end %>
            </span>

            <% if @moves_project.unarchived? %>
              <div class="small flex-shrink-0 ms-4">
                <%= link_to new_moves_project_step_move_path(moves_project_step, redirect_to_on_success: request.path),
                            class: "link-success link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover"\
                do %>
                  <span class="bi bi-plus-lg"></span>
                  <span><%= t("moves.new.title") %></span>
                <% end %>
              </div>
            <% end %>
          </div>

          <%= turbo_frame_tag(
                dom_id(Move, :table), loading: :lazy, src: moves_project_step_moves_path(moves_project_step),
              ) do %>
            <div class="w-100 d-flex justify-content-center align-items-center gap-3">
              <span role="status"><%= t("has_many_turbo_frame_component.loading") %></span>
              <span class="spinner-grow text-primary" aria-hidden="true"></span>
            </div>
          <% end %>

          <% if @moves_project.unarchived? && moves_project_step.moves.any? && !moves_project_step.executed? %>
            <% card.with_footer do %>
              <%= render ButtonComponent.new(
                    t(".action.execute_all"),
                    url: execute_moves_project_moves_project_step_path(@moves_project, moves_project_step),
                    variant: :outline_primary,
                    title: t(".action.execute_step_moves"),
                    icon: :"check2-square",
                    size: :sm,
                    is_responsive: true,
                    extra_classes: "ms-auto",
                    aria: { hidden: true },
                    data: {
                      turbo: true,
                      turbo_method: :patch,
                      turbo_confirm: t(".execute_confirmation"),
                      controller: "tooltip",
                      bs_placement: "left",
                      turbo_frame: :_top,
                    },
                  ) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="col-12">
      <%= render partial: "moves_project_steps/frames_grid",
                 locals: {
                   moves_project_step: @moves_project.steps&.last,
                   frames: @moves_project.steps&.last&.frames_with_moves_at_current_step,
                   moves: @moves_project.moves,
                 } %>
    </div>
  </div>

  <%= render ChangelogEntries::ObjectListComponent.new(@moves_project) %>
</div>
