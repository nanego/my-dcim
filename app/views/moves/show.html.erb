<% breadcrumb.add_step(title = @move.decorated.display_name) %>

<%= render Page::HeadingComponent.new(
      title:,
      breadcrumb:,
      back_button_url: moves_project_step_moves_path(@moves_project_step),
    ) do |heading| %>
  <% heading.with_right_content do %>
    <% unless @move.executed? || @move.moves_project.archived? %>
      <span>
        <button type="button" class="btn btn-lg link-secondary" data-bs-toggle="dropdown" aria-expanded="false">
          <span class="bi bi-three-dots-vertical"></span>
        </button>
        <ul class="dropdown-menu">
          <% if allowed_to?(:execute?, @move) %>
            <li>
              <%= link_to execute_moves_project_step_move_path(@moves_project_step, @move),
                          class: "dropdown-item",
                          data: {
                            turbo: true,
                            turbo_method: :patch,
                            turbo_confirm: t("moves.execute_confirmation"),
                            turbo_frame: :_top,
                            controller: "tooltip",
                          },
                          title: t("moves.action.execute_move") do %>
                <span class="bi bi-check2-square text-primary me-1"></span>
                <span><%= t("action.execute") %></span>
              <% end %>
            </li>
          <% end %>
          <% if allowed_to?(:manage?, @move) %>
            <li>
              <%= link_to edit_moves_project_step_move_path(@moves_project_step, @move),
                          class: "dropdown-item" do %>
                <span class="bi bi-pencil text-info me-1"></span>
                <span><%= t("action.edit") %></span>
              <% end %>
            </li>
          <% end %>
          <% if allowed_to?(:create, @move.connections.build) %>
            <li>
              <%= link_to remove_existing_connections_moves_project_step_move_path(@moves_project_step, @move),
                class: "dropdown-item",
                data: { turbo: true, turbo_method: :post, turbo_confirm: t("action.confirm") } do %>
                <span class="bi bi-trash text-danger me-1"></span>
                <span><%= t(".remove_existing_connections") %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </span>
    <% end %>
  <% end %>
<% end %>

<div class="col-12 p-4 border-top d-flex flex-column row-gap-4">
  <div class="row row-cols-1 row-cols-lg-2 row-gap-4">
    <div class="col">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= t("show.cards.identification") %>
        <% end %>

        <dl class="show-page_dl d-grid row-gap-2 mb-0">
          <dt class="pb-2"><%= MovesProject.model_name.human %></dt>
          <dd class="mb-0 pb-2 ps-3"><%= @move.moves_project %></dd>

          <dt class="pb-2"><%= Move.human_attribute_name(:moves_project_step_id) %></dt>
          <dd class="mb-0 pb-2 ps-3"><%= @move.step %></dd>

          <dt class="pb-2"><%= Move.human_attribute_name(:status) %></dt>
          <dd class="mb-0 pb-2 ps-3">
            <%= render @move.decorated.status_to_badge_component %>
            <% if date = @move.decorated.planned_or_executed_date %>
              <span class="mx-1 fw-light text-body-secondary"><%= t("at") %></span>
              <span class="font-monospace"><%= date %></span>
            <% end %>
          </dd>
        </dl>
      <% end %>
    </div>

    <div class="col">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= t("show.cards.visualization") %>
        <% end %>

        <% card.with_body(extra_classes: "bg-body-tertiary rounded-bottom") do %>
          <span class="row align-items-center">
            <span class="col-5 d-inline-flex justify-content-start">
              <span class="d-inline-flex bg-body border border-success-subtle rounded-3 p-3 flex-column flex-grow-1 row-gap-1">
                <span class="d-flex align-items-start">
                  <span class="bi bi-geo-alt text-primary me-1"></span>
                  <span><%= @move.prev_frame.room.name_with_site %></span>
                </span>
                <span class="d-flex align-items-start fw-light">
                  <span class="bi bi-file-minus text-success me-1"></span>
                  <span><%= @move.prev_frame %></span>
                </span>
                <span class="d-flex align-items-start">
                  <span class="fw-light text-secondary me-1"><%= Frame.human_attribute_name(:u) %></span>
                  <span class="font-monospace"><%= @move.prev_position %></span>
                </span>
              </span>
            </span>
            <span class="d-inline-flex col-2 align-items-center justify-content-center fs-4">
              <%= render BadgeComponent.new(color: :light, variant: :pill) do %>
                <span class="bi bi-box-seam"></span>
                <span class="bi bi-arrow-right-short ms-1"></span>
              <% end %>
            </span>
            <span class="col-5 d-inline-flex justify-content-end">
              <span class="d-inline-flex bg-body border border-danger-subtle rounded-3 p-3 flex-column flex-grow-1 row-gap-1">
                <span class="d-flex align-items-start">
                  <span class="bi bi-geo-alt text-primary me-1"></span>
                  <span><%= @move.frame.room.name_with_site %></span>
                </span>
                <span class="d-flex align-items-start fw-light">
                  <span class="bi bi-file-minus text-success me-1"></span>
                  <span><%= @move.frame %></span>
                </span>
                <span class="d-flex align-items-start">
                  <span class="fw-light text-secondary me-1"><%= Frame.human_attribute_name(:u) %></span>
                  <span class="font-monospace"><%= @move.position %></span>
                </span>
              </span>
            </span>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render partial: "moveable", locals: { move: @move, moveable: @move.moveable } %>

  <%= render HasManyTurboFrameComponent.new(
        Move::Connection.model_name.human.pluralize,
        url: move_connections_path(@move),
        frame_id: dom_id(Move::Connection, :table),
      ) %>

  <%= render ChangelogEntries::ObjectListComponent.new(@move) %>
</div>

<%= render "ports/modal_edit_port" %>
