<div class="move_connection_form p-4 pb-0">
  <%= form_with(model: move_connection,
                url:,
                html: { role: "form" }) do |f| %>
    <%= render FormErrorsComponent.new(move_connection) %>

    <%= render CardComponent.new(extra_classes: "bg-body-tertiary") do |card| %>
      <% card.with_header do %>
        <div class="d-flex">
          <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"
                                                          aria-label="<%= t("action.close") %>"></button>
        </div>
      <% end %>

      <div class="row g-3">
        <fieldset class="col-12">
          <%= f.label :port_from_id, class: "form-label" %>
          <%= render CardComponent.new do %>
            <div id="back_departure_server"
                 class="back_server d-flex flex-row-reverse flex-wrap no-decoration-link">
              <%= render partial: "servers/draw_server_compact",
                         locals: {
                           server: move_connection.move.moveable,
                           selected_port: move_connection.port_from,
                           should_hide_left_block: true,
                         } %>
            </div>
          <% end %>
          <%= f.hidden_field :port_from_id, value: move_connection.port_from_id %>
        </fieldset>
      </div>

      <fieldset class="col-12 mt-4" data-controller="reveal" data-reveal-hidden-class="d-none">
        <%= f.label :port_to_id, class: "form-label" %>
        <%= render CardComponent.new do |c| %>
          <% c.with_header do %>
            <div class="d-flex justify-content-between" id="select_destination_bay">
              <span id="restricted_destinations" class="w-50" data-reveal-target="item">
                <%= select_tag "to_server",
                               move_connection.decorated.available_servers_options_for_select,
                               include_blank: true,
                               class: "form-select",
                               data: {
                                 controller: :select,
                                 select_clear_button_title_value: t("action.clear_all"),
                               },
                               placeholder: t("select.placeholder"),
                               onchange: "update_destination_server(this.value)" %>
              </span>
              <span id="all_destinations" class="d-none w-50" data-reveal-target="item">
                <%= select_tag "to_server",
                               grouped_options_for_select(
                                 all_servers_per_frames,
                                 { selected: move_connection.port_to&.server_id },
                               ),
                               include_blank: true,
                               class: "form-select",
                               data: {
                                 controller: :select,
                                 select_clear_button_title_value: t("action.clear_all"),
                               },
                               placeholder: t("select.placeholder"),
                               onchange: "update_destination_server(this.value)" %>
              </span>
              <button class="btn btn-link btn-sm me-auto" data-action="click->reveal#toggle" type="button">
                <span data-reveal-target="item">
                  <%= t("connections.form.action.show_more_bay") %>
                </span>
                <span data-reveal-target="item" class="d-none">
                  <%= t("connections.form.action.show_less_bay") %>
                </span>
              </button>
            </div>
          <% end %>
          <div id="back_destination_server" class="back_server overflow-scroll">
            <% if move_connection.port_to %>
              <%= render partial: "servers/draw_server_compact",
                         locals: {
                           server: move_connection.port_to.server,
                           selected_port: move_connection.port_to,
                           should_hide_left_block: true,
                         } %>
            <% end %>
          </div>
        <% end %>
        <%= f.hidden_field :port_to_id, value: move_connection.port_to_id %>
      </fieldset>

      <fieldset class="col-12 mt-4">
        <%= f.label :vlans, class: "form-label" %>
        <%= f.text_field :vlans, class: "form-control", value: move_connection.vlans %>
      </fieldset>

      <fieldset class="col-12 mt-4">
        <%= f.label :cable_color, class: "form-label" %>
        <%= f.hidden_field :cable_color, value: move_connection.cable_color %>
      </fieldset>

      <fieldset class="col-12 mt-4">
        <%= f.label :cable_name, class: "form-label" %>
        <%= f.text_field :cable_name, class: "form-control", value: move_connection.cable_name %>
      </fieldset>
    <% end %>

    <div class="col-12 d-flex py-4 mt-4 sticky-bottom bg-body-tertiary border-top">
      <% if move_connection.persisted? %>
        <%= link_to move_connection_path(move_connection.move, move_connection),
                    method: :delete,
                    class: "btn btn-outline-danger" do %>
          <span class="bi bi-trash"></span>
          <span class="ms-1"><%= t("action.delete") %></span>
        <% end %>
      <% else %>
        <%= link_to move_connections_path(
              move_connection.move,
              move_connection: { port_from_id: move_connection.port_from, vlans: move_connection.vlans },
            ),
                    method: :post,
                    class: "btn btn-outline-danger" do %>
          <span class="bi bi-trash"></span>
          <span class="ms-1"><%= t("action.delete") %></span>
        <% end %>
      <% end %>

      <span class="d-inline-flex ms-auto gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          <%= t("action.cancel") %>
        </button>

        <%= f.submit t("action.save"),
                     class: "btn btn-outline-primary",
                     disabled: move_connection.port_to_id.present? ? false : :disabled %>
      </span>
    </div>
  <% end %>
</div>

<script type="text/javascript" nonce="<%= request.content_security_policy_nonce %>">
  loadPaletteColorPicker('[name="move_connection[cable_color]"]');

  document.getElementById("back_departure_server").addEventListener("click", (e) => {
    e.preventDefault();
  })

  document.getElementById("back_destination_server").addEventListener("click", (e) => {
    e.preventDefault();

    if (e.target.classList.contains("port")) {
      select_destination_port(e.target);
    }
  })

  function update_destination_server(server_id) {
    let submit = document.querySelector("#back_destination_server")
                         .closest("form")
                         .querySelector("input[type=\"submit\"]");
    submit.disabled = true;

    if (server_id != undefined && server_id != "") {
      $.ajax({
          method: "POST",
          url: "<%= update_destination_server_move_connections_path(move_connection.move) %>",
          data: { server_id: server_id, with_move_connection: 1 }
      }).done(function () {
        let port_id = document.querySelector("input[name=\"move_connection[port_to_id]\"]");

        if (port = document.getElementById(port_id.value)) {
          select_destination_port(port);
        }
      });
    }
  }

  function select_destination_port(port) {
    if (selected_port = document.querySelector("#back_destination_server span.port_container.selected")) {
      selected_port.classList.remove("selected");
    }
    port.closest("span").classList.add("selected");

    document.querySelector("[name=\"move_connection[port_to_id]\"]").value = port.id;

    port.closest("form").querySelector("input[type=\"submit\"]").disabled = false;
  }
</script>
