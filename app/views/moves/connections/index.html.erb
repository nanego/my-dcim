<% breadcrumb.add_step(title = @move.decorated.display_name) %>

<%= render Page::HeadingComponent.new(
      title:, breadcrumb:,
      back_button_url: moves_project_step_move_path(@move.step, @move),
    ) %>

<div class="p-4 border-top d-flex flex-column row-gap-4">
  <%= turbo_frame_tag(dom_id(Move::Connection, :table), data: { turbo_action: :advance }) do %>
    <div class="moves-connections-index d-flex flex-column row-gap-4">
      <%= render List::DataTableComponent.new(@move_connections) do |table| %>
        <% if allowed_to?(:destroy?, with: Move::ConnectionPolicy) %>
          <% table.with_bulk_action(
               url: bulk_move_connections_path(@move),
               method: :delete,
               class: "btn btn-danger btn-sm",
               data: { turbo_confirm: t("action.confirm") },
             ) do %>
            <span class="bi bi-trash pe-none" title="<%= t("action.delete") %>"></span>
          <% end %>
        <% end %>

        <% table.with_column(t(".representation_title"), v_align: :baseline) do |move_connection| %>
          <div class="moves-connections-draw">
            <%= render partial: "draw", locals: { move_connection: } %>
          </div>
        <% end %>

        <% table.with_column(style: "min-width: 70px; width: 70px") do |move_connection| %>
          <div class="btn-group btn-group-sm" role="group" aria-label="...">
            <% if allowed_to?(:update?, move_connection, with: Move::ConnectionPolicy) %>
              <%= link_to edit_move_connection_path(@move, move_connection),
                          class: "btn btn-outline-info",
                          title: t("action.edit"),
                          data: { turbo_frame: :_top, controller: "tooltip" },
                          aria: {
                            label: t("action.edit"),
                          } do %>
                <span class="bi bi-pencil" aria-hidden="true"></span>
                <span class="visually-hidden"><%= t("action.edit") %></span>
              <% end %>
            <% end %>

            <% if allowed_to?(:destroy?, move_connection, with: Move::ConnectionPolicy) %>
              <%= link_to move_connection_path(@move, move_connection),
                          title: t("action.delete"),
                          method: :delete,
                          data: {
                            turbo_frame: :_top,
                            controller: "tooltip",
                          },
                          class: "btn btn-outline-danger",
                          aria: {
                            label: t("action.delete"),
                          } do %>
                <span class="bi bi-trash" aria-hidden="true"></span>
                <span class="visually-hidden"><%= t("action.delete") %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
