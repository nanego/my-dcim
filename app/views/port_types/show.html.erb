<% breadcrumb.add_step(@port_type) %>

<%= render Page::HeadingShowComponent.new(
      resource: @port_type,
      title: @port_type.to_s,
      breadcrumb:,
      editable: allowed_to?(:update?, @port_type),
    ) %>

<div class="p-4 border-top d-flex flex-column row-gap-4">
  <div class="row row-cols-1 row-cols-lg-2 row-gap-4">
    <div class="col">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= t("show.cards.identification") %>
        <% end %>

        <dl class="show-page_dl d-grid row-gap-2 mb-0">
          <% %i[name].each do |attribute_name| %>
            <dt class="pb-2"><%= PortType.human_attribute_name(attribute_name) %></dt>
            <dd class="mb-0 pb-2 ps-3"><%= @port_type.public_send(attribute_name) %></dd>
          <% end %>
        </dl>
      <% end %>
    </div>

    <div class="col">
      <%= render CardComponent.new do |card| %>
        <% card.with_header do %>
          <%= t("show.cards.features") %>
        <% end %>

        <dl class="show-page_dl d-grid row-gap-2 mb-0">
          <% icon = @port_type.is_power? ? "check" : "x" %>
          <dt class="pb-2"><%= PortType.human_attribute_name(:power) %></dt>
          <dd class="mb-0 pb-2 ps-3"><span class="bi bi-<%= icon %>-square"></span></dd>
        </dl>

        <dl class="show-page_dl d-grid row-gap-2 mb-0">
          <dt class="pb-2"><%= PortType.human_attribute_name(:usable_by) %></dt>
            <dd class="mb-0 pb-2 ps-3"><%= @port_type.usable_by.to_sentence %></dd>
        </dl>
      <% end %>
    </div>
  </div>

  <%= render ChangelogEntries::ObjectListComponent.new(@port_type) %>
</div>
