<%# Same shape as the loaded block, so the form below doesn't jump when Netsight answers %>
<%= render CardComponent.new(extra_classes: "mt-3", source: "Netsight") do |card| %>
  <% card.with_header do %>
    <%= t("ports.netsight_port.show.title") %>
  <% end %>

  <%# Filler text sizes each placeholder like the real content, the placeholder class hides it %>
  <div class="placeholder-glow" aria-hidden="true">
    <div class="d-flex flex-wrap align-items-baseline column-gap-3 row-gap-1">
      <span class="fw-semibold placeholder">xxxxxxxxx <span class="font-monospace">x:x</span></span>
      <span class="badge text-bg-secondary placeholder col-1">&nbsp;</span>
      <span class="small placeholder">x xxxx</span>
      <span class="small placeholder">xxxxxxxxxxxxxx</span>
    </div>

    <div class="d-flex flex-wrap align-items-baseline gap-2 mt-2">
      <span class="placeholder">xxxx</span>
      <span class="font-monospace placeholder">xxxxx, xxxxx</span>
      <span class="btn btn-sm btn-secondary disabled placeholder col-2">&nbsp;</span>
    </div>
  </div>

  <% card.with_footer do %>
    <span class="small text-body-secondary" role="status"><%= t(".message") %></span>
    <span class="spinner-border spinner-border-sm text-body-secondary ms-2" aria-hidden="true"></span>
  <% end %>
<% end %>
