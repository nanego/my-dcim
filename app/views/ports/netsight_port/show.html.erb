<%= turbo_frame_tag "netsight_port" do %>
  <%= render CardComponent.new(extra_classes: "mt-3", source: "Netsight") do |card| %>
    <% card.with_header do %>
      <%= t(".title") %>
      <% if @demo %>
        <span class="badge text-bg-secondary ms-2"><%= t(".demo") %></span>
      <% end %>
    <% end %>

    <% if !@configured %>
      <%= t(".not_configured") %>
    <% elsif @connection_error.present? %>
      <%= t(".connection_error") %> <pre><code><%= @connection_error %></code></pre>
    <% elsif @location.status == :no_switch %>
      <%= t(".no_switch") %>
    <% elsif @netsight_port.nil? %>
      <%= t(".port_not_found", switch: @location.sys_name, if_index: @location.if_index) %>
    <% else %>
      <div class="d-flex flex-wrap align-items-baseline column-gap-3 row-gap-1">
        <span class="fw-semibold" title="<%= t(".switch") %> / <%= t(".port") %>">
          <%= @netsight_port.sys_name %> <span class="font-monospace"><%= @netsight_port.if_name %></span>
        </span>
        <% if @netsight_port.oper_status.present? %>
          <span class="badge <%= @netsight_port.oper_status == "Up" ? "text-bg-success" : "text-bg-secondary" %>"
                title="<%= t(".status") %>"><%= @netsight_port.oper_status %></span>
        <% end %>
        <% if @netsight_port.speed.present? %>
          <span class="small text-body-secondary" title="<%= t(".speed") %>"><%= @netsight_port.speed %></span>
        <% end %>
        <% if @netsight_port.description.present? %>
          <span class="small text-body-secondary text-break" title="<%= t(".description") %>"><%= @netsight_port.description %></span>
        <% end %>
        <% if @netsight_port.lag_member? %>
          <span class="small text-body-secondary"><%= t(".lag_member", master: @netsight_port.lag_master_name) %></span>
        <% end %>
      </div>

      <div class="d-flex flex-wrap align-items-baseline gap-2 mt-2">
        <span class="text-body-secondary"><%= t(".vlans") %></span>
        <% if !@netsight_port.vlans_collected %>
          <span class="fst-italic text-body-secondary"><%= t(".vlans_not_collected") %></span>
        <% elsif @netsight_port.default_vlan_only? %>
          <%= t(".default_vlan") %>
        <% else %>
          <span class="font-monospace"><%= @netsight_port.dcim_vlans.presence || t(".no_vlan") %></span>

          <% unless @netsight_port.matches_dcim?(@port.vlans) %>
            <span class="badge text-bg-warning"><%= t(".differs_from_dcim") %></span>
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    data-action="netsight-vlans#apply"
                    data-netsight-vlans-value-param="<%= @netsight_port.dcim_vlans %>">
              <%= t(".apply_vlans") %>
            </button>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% scanned_at = @netsight_port&.scanned_at %>
    <% sync_page = allowed_to?(:index?, with: NetsightSyncResultPolicy) %>
    <% if scanned_at || sync_page %>
      <% card.with_footer do %>
        <% if scanned_at %>
          <span class="small text-body-secondary" title="<%= l(scanned_at, format: :long) %>">
            <%= t(".scanned_at", date: l(scanned_at, format: :short)) %>
          </span>
        <% end %>
        <% if sync_page %>
          <%= link_to t(".sync_page"), netsight_sync_results_path, class: "small netsight-sync-page-link ms-auto", data: { turbo_frame: "_top" } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
