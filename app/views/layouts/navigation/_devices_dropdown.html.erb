<li class="nav-item" role="menuitem">
  <%= link_to Server.model_name.human(count: 2), servers_grids_path, class: "nav-link d-block d-lg-none" %>
</li>
<li class="nav-item dropdown d-none d-lg-block" role="menuitem">
  <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown"
    aria-expanded="false">
    <%= Server.model_name.human(count: 2) %>
  </button>
  <ul class="dropdown-menu">
    <li><%= link_to t(".search_equipment"), servers_grids_path, class: "dropdown-item" %></li>
    <% glpi_allowed = allowed_to?(:index?, with: ExternalAppRecordPolicy) %>
    <% netsight_allowed = allowed_to?(:index?, with: NetsightSyncResultPolicy) %>
    <% if glpi_allowed || netsight_allowed %>
      <li><hr class="dropdown-divider"></li>
      <% if glpi_allowed %>
        <li><%= link_to t("external_app_records.index.title"), external_app_records_path, class: "dropdown-item" %></li>
      <% end %>
      <% if netsight_allowed %>
        <li><%= link_to t("netsight_sync_results.index.title"), netsight_sync_results_path, class: "dropdown-item" %></li>
      <% end %>
    <% end %>
    <li><hr class="dropdown-divider"></li>
    <li><h6 class="dropdown-header"><%= t(".filter_by") %></h6></li>
    <li class="nav-item dropdown-submenu" role="menuitem">
      <button class="dropdown-toggle dropdown-item" data-bs-toggle="dropdown" type="button" aria-haspopup="true"
        aria-expanded="false">
        <%= Manager.model_name.human %>
      </button>
      <ul class="dropdown-menu">
        <% Manager.order(Manager.arel_table[:name].lower).each do |c| %>
          <li>
            <%= link_to c.name,
                        visualization_rooms_path(manager_id: c.id, view: params[:view], bg: (params[:bg] || "modele") ),
                        class: class_names("dropdown-item", active: params[:manager_id] == c.id.to_s) %>
          </li>
        <% end %>
      </ul>
    </li>
    <li class="nav-item dropdown-submenu" role="menuitem">
      <button class="dropdown-toggle dropdown-item" data-bs-toggle="dropdown" type="button" aria-haspopup="true"
        aria-expanded="false">
        <%= Cluster.model_name.human %>
      </button>
      <ul class="dropdown-menu overflow-auto" style="max-height:70vh;">
        <li class="d-flex">
          <% Cluster.order(Cluster.arel_table[:name].lower).in_groups(3).each do |clusters| %>
              <ul class="list-unstyled">
                <% clusters.each do |c| %>
                    <% if c.present? %>
                      <li>
                          <%= link_to c.to_s,
                                      visualization_rooms_path(cluster_id: c.id,
                                                          view: params[:view],
                                                          bg: (params[:bg] || "modele") ),
                                      class: class_names("dropdown-item", active: params[:cluster_id] == c.id.to_s) %>
                        </li>
                    <% end %>
                <% end %>
              </ul>
          <% end %>
        </li>
      </ul>
    </li>
    <li class="nav-item dropdown-submenu" role="menuitem">
      <button class="dropdown-toggle dropdown-item" data-bs-toggle="dropdown" type="button" aria-haspopup="true"
        aria-expanded="false">
        <%= Modele.model_name.human %>
      </button>
      <ul class="dropdown-menu overflow-auto modeles"
          style="max-height:70vh;">
        <li class="d-flex">
          <% Modele.all_sorted_with_servers.to_a.in_groups(3, false).each do |modeles| %>
            <ul class="list-unstyled" style="width: 16rem;">
              <% modeles.each do |modele| %>
                <li>
                  <%= link_to modele.name_with_brand,
                              visualization_rooms_path(modele_id: modele.id,
                                                       view: params[:view],
                                                       bg: params[:bg] || "modele"),
                              class: class_names("dropdown-item text-wrap", active: params[:modele_id] == modele.id.to_s) %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      </ul>
    </li>
  </ul>
</li>
